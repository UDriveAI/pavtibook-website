rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: checks if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Rules for organization branding files (logos, signatures, QR code)
    function belongsToOrg(orgId) {
      return isSignedIn() && 
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organization_id == orgId
        );
    }

    match /organizations/{orgId}/{allPaths=**} {
      allow read: if true; // Public read for receipt rendering and sharing
      allow write: if belongsToOrg(orgId); // Only allow write if user belongs to this organization
    }

    // Rules for generated receipt PDFs
    match /receipt_pdfs/{receiptId} {
      allow read: if true; // Public read for sharing and downloading
      allow write: if isSignedIn() 
        && receiptId.matches('.*\\.pdf$')
        && request.resource.size < 10 * 1024 * 1024 // 10MB limit
        && request.resource.contentType == 'application/pdf'
        && belongsToOrg(firestore.get(/databases/(default)/documents/receipts/$(receiptId.replace('.pdf', ''))).data.organizationId);
    }

    // Rules for generated receipt images (JPG or PNG, authenticated users only)
    match /receipt_images/{receiptId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 10 * 1024 * 1024 // 10MB limit
        && (request.resource.contentType == 'image/jpeg'
            || request.resource.contentType == 'image/png')
        && belongsToOrg(firestore.get(/databases/(default)/documents/receipts/$(receiptId.replace('.jpg', '').replace('.png', ''))).data.organizationId);
    }

    // Rules for user profile photos
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
